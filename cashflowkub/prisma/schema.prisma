generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A place money lives: bank, cash, e-wallet or credit line.
model Account {
  id        Int    @id @default(autoincrement())
  name      String
  sub       String @default("")
  balance   Int    @default(0) /// negative for credit balances owed
  icon      String @default("landmark")
  tint      String @default("doc")
  kind      String @default("bank") /// bank | cash | ewallet | credit
  startDate String @default("") @map("start_date")
  startTh   String @default("") @map("start_th")
  sort      Int    @default(0)

  @@map("accounts")
}

/// Spending/earning bucket; `key` is the slug used by transactions, budgets and the plan.
model Category {
  id    Int    @id @default(autoincrement())
  key   String @unique
  label String
  th    String @default("")
  short String @default("")
  icon  String @default("circle")
  tint  String @default("doc")
  type  String @default("expense") /// income | expense
  sub   String @default("") /// need | want | saving | debt
  sort  Int    @default(0)

  @@map("categories")
}

/// One money movement. Signed amount: negative = expense.
model Transaction {
  id       Int      @id @default(autoincrement())
  name     String
  cat      String   @map("cat_key")
  acct     String   @map("account")
  amount   Int
  date     DateTime @db.Date
  note     String   @default("")
  /// Loan interest part of a debt payment (baht, >= 0).
  interest Int      @default(0)
  /// Other loan fees, excluding interest (baht, >= 0).
  fee      Int      @default(0)
  /// Saving goal name for saving-category rows.
  goal     String   @default("")

  @@index([date])
  @@map("transactions")
}

model Budget {
  id    Int    @id @default(autoincrement())
  cat   String @map("cat_key")
  spent Int    @default(0)
  limit Int    @map("limit_amt")
  sort  Int    @default(0)

  @@map("budgets")
}

model Goal {
  id      Int    @id @default(autoincrement())
  name    String
  th      String @default("")
  icon    String @default("target")
  saved   Int    @default(0)
  target  Int
  monthly Int    @default(0)
  by      String @default("")
  sort    Int    @default(0)

  @@map("goals")
}

/// A loan or credit line. paid = openingPaid + Σ payments.principal (kept in sync by the service).
model Debt {
  id           Int           @id @default(autoincrement())
  name         String
  th           String        @default("")
  icon         String        @default("credit-card")
  tint         String        @default("pdf")
  kind         String        @default("personal") /// paylater | cashloan | bankloan | creditcard | personal
  lender       String        @default("")
  original     Int
  openingPaid  Int           @default(0) @map("opening_paid") /// principal repaid before tracking started
  paid         Int           @default(0)
  apr          Float         @default(0) /// nominal annual %
  calc         String        @default("reducing") /// flat | reducing
  monthly      Int           @default(0) /// minimum payment (open-ended / revolving)
  fixedPayment Int           @default(0) @map("fixed_payment") /// statement instalment; > 0 overrides calc
  termMonths   Int           @default(0) @map("term_months")
  dueDay       Int           @default(1) @map("due_day")
  graceDays    Int           @default(0) @map("grace_days")
  lateFee      Int           @default(0) @map("late_fee")
  penaltyApr   Float         @default(0) @map("penalty_apr")
  done         Boolean       @default(false)
  revolving    Boolean       @default(false)
  sort         Int           @default(0)
  payments     DebtPayment[]

  @@map("debts")
}

/// One recorded repayment, already split into fee / interest / principal.
model DebtPayment {
  id        Int      @id @default(autoincrement())
  debtId    Int      @map("debt_id")
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  amount    Int
  principal Int
  interest  Int
  fee       Int
  note      String   @default("")

  @@index([debtId, date])
  @@map("debt_payments")
}

/// Key/value app settings (e.g. monthlyIncome for DSR).
model Setting {
  key   String @id
  value String

  @@map("settings")
}

model Asset {
  id    Int    @id @default(autoincrement())
  name  String
  th    String @default("")
  icon  String @default("wallet")
  tint  String @default("doc")
  value Int    @default(0)
  sort  Int    @default(0)

  @@map("assets")
}

/// A recurring (or one-time) payment due on a day of the month. Which months it occurs in comes from
/// startMonth / endMonth / freq / everyMonths; paid state is per month in BillPayment.
model Bill {
  id          Int           @id @default(autoincrement())
  name        String
  th          String        @default("")
  icon        String        @default("receipt")
  tint        String        @default("pdf")
  amount      Int
  dueDay      Int           @map("due_day")
  /// Deprecated: per-month payments live in bill_payments. No longer read.
  paid        Boolean       @default(false)
  freq        String        @default("monthly") /// monthly (recurring every everyMonths) | once (only in startMonth)
  cat         String        @default("bills") @map("cat_key")
  kind        String        @default("bill") /// bill | subscription
  startMonth  String        @default("2026-06") @map("start_month") /// YYYY-MM
  endMonth    String        @default("") @map("end_month") /// YYYY-MM, inclusive; empty = no end
  everyMonths Int           @default(1) @map("every_months") /// 1-12
  sort        Int           @default(0)
  payments    BillPayment[]

  @@map("bills")
}

/// A bill marked paid for one month (YYYY-MM). A row means paid.
model BillPayment {
  id     Int    @id @default(autoincrement())
  billId Int    @map("bill_id")
  month  String
  bill   Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, month])
  @@map("bill_payments")
}

model Channel {
  id        Int    @id @default(autoincrement())
  name      String
  th        String @default("")
  kind      String @default("saving") /// saving | mf | pf | stock | gold | bond
  icon      String @default("piggy-bank")
  tint      String @default("doc")
  opening   Int    @default(0)
  startDate String @default("") @map("start_date")
  startTh   String @default("") @map("start_th")
  sort      Int    @default(0)

  @@map("channels")
}

model IncomeCategory {
  id   Int    @id @default(autoincrement())
  name String
  th   String @default("")
  sub  String @default("main") /// main | side | passive
  icon String @default("briefcase")
  tint String @default("xls")
  sort Int    @default(0)

  @@map("income_categories")
}

/// Planned-vs-actual row for a month; `type` partitions the three plan tables.
model PlanItem {
  id      Int    @id @default(autoincrement())
  type    String /// income | expense | savings
  name    String
  th      String @default("")
  icon    String @default("")
  tint    String @default("")
  cat     String @default("") @map("cat_key")
  sub     String @default("")
  planned Int    @default(0)
  actual  Int    @default(0)
  month   String /// YYYY-MM
  sort    Int    @default(0)

  @@index([month])
  @@map("plan_items")
}

model AssetSnapshot {
  id    Int    @id @default(autoincrement())
  name  String
  th    String @default("")
  group String @map("grp") /// bank | savings | invest | other
  icon  String @default("")
  tint  String @default("")
  prev  Int    @default(0)
  curr  Int    @default(0)
  month String
  sort  Int    @default(0)

  @@map("asset_snapshots")
}

model NetWorthHistory {
  id      Int    @id @default(autoincrement())
  month   String
  monthTh String @map("month_th")
  value   Int
  sort    Int    @default(0)

  @@map("net_worth_histories")
}

model MonthlyCashflow {
  id      Int    @id @default(autoincrement())
  month   String
  income  Int
  expense Int
  sort    Int    @default(0)

  @@map("monthly_cashflows")
}

model DaySpend {
  id     Int    @id @default(autoincrement())
  day    Int
  amount Int
  month  String

  @@map("day_spends")
}

model SetupGoal {
  id          Int                @id @default(autoincrement())
  kind        String /// emergency | stocks | retirement | custom
  name        String
  th          String             @default("")
  icon        String             @default("target")
  tint        String             @default("doc")
  startDate   String             @default("") @map("start_date")
  startTh     String             @default("") @map("start_th")
  endDate     String             @default("") @map("end_date")
  endTh       String             @default("") @map("end_th")
  inflation   Float              @default(0)
  target      Int                @default(0)
  opening     Int                @default(0)
  currentAge  Int?               @map("current_age")
  retireAge   Int?               @map("retire_age")
  useUntilAge Int?               @map("use_until_age")
  monthlyNeed Int?               @map("monthly_need")
  sort        Int                @default(0)
  channels    SetupGoalChannel[]

  @@map("setup_goals")
}

model SetupGoalChannel {
  id          Int       @id @default(autoincrement())
  setupGoalId Int       @map("setup_goal_id")
  setupGoal   SetupGoal @relation(fields: [setupGoalId], references: [id], onDelete: Cascade)
  name        String
  th          String    @default("")
  pct         Int

  @@map("setup_goal_channels")
}
