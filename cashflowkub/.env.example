# Local Postgres. Replace the password with your local Postgres password.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cashflowkub
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cashflowkub_test
# Used by the e2e page smoke tests (a running `pnpm start`).
E2E_BASE_URL=http://localhost:3000
# Better Auth signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app, used by Better Auth for cookies and callbacks.
BETTER_AUTH_URL=http://localhost:3000
# Set to "off" only in tests to disable Better Auth rate limiting.
# BETTER_AUTH_RATE_LIMIT=off
# AES-256-GCM key for encrypted free-text fields (base64 of 32 bytes). Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Rust backend (required only after a finance domain is routed through Rust).
BACKEND_URL=http://127.0.0.1:8080
# Generate with: openssl rand -base64 32. Keep identical in Next.js and Rust environments.
BACKEND_SERVICE_TOKEN=
# Password for the seeded demo user (demo@cashflowkub.local). No default; pick your own.
SEED_DEMO_PASSWORD=
# Data controller named in the privacy notice (/privacy) and where people send PDPA requests. The page throws if either is unset.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
