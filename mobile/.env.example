# Optional. If unset, the app auto-detects the API:
#  - iOS simulator / web  -> http://localhost:8080
#  - physical device      -> http://<your-metro-host-ip>:8080
# Set this to override (e.g. a deployed API or Android emulator host).
# EXPO_PUBLIC_API_URL=http://localhost:8080
# Android emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
