DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cashflowkub
DATA_ENCRYPTION_KEY=
BACKEND_SERVICE_TOKEN=
BACKEND_BIND_ADDRESS=127.0.0.1:8080

# Local-only Better Auth login seeds. When enabled, each startup resets the
# passwords for these emails and signs their sessions out. Keep disabled outside
# a database where repeated credential resets are explicitly intended.
SEED_ACCOUNTS_ENABLED=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
SEED_CLIENT_EMAIL=
SEED_CLIENT_PASSWORD=
SEED_CLIENT_NAME=Client
