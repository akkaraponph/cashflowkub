              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "accounts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Main account\",\n  \"kind\": \"bank\",\n  \"balance\": 12000\n}"
            },
            "description": ""
          }
        },
