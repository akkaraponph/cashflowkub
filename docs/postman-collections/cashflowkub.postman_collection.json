{
  "info": {
    "name": "CashflowKub (auth, privacy, and backend operations)",
    "description": "Sign-in, account deletion and PDPA endpoints. Every /api/v1/* call needs the session cookie from sign-in and returns 401 {error:'not signed in', code:'unauthorized'} without it. Send requests in one cookie jar: sign up or sign in first. Accounts, categories, budgets, goals, assets, channels, income-categories, and settings are proxied to the private Rust backend. Transaction CRUD, batch operations, and the private paged reader use Rust behind the Next.js session gateway. Bills, plan items, bill payments, and asset snapshot reads now use Rust behind the session gateway. The setup endpoint and debt endpoints remain in Next.js pending debt view parity.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "auth",
      "item": [
        {
          "name": "Sign up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-up/email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "sign-up",
                "email"
              ]
            },
            "description": "camelCase privacyVersion is Better Auth's field. 400 unless it is the current notice version. Sets the session cookie (kept by Postman's cookie jar).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ploy\",\n  \"email\": \"ploy@example.com\",\n  \"password\": \"a-long-password\",\n  \"privacyVersion\": \"2026-10-19\"\n}"
            }
          }
        },
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
